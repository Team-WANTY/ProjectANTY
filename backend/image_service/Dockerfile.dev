FROM python:3.12-slim-bookworm

COPY --from=ghcr.io/astral-sh/uv:0.9.5 /uv /uvx /bin/

WORKDIR /app

# Copy source code
COPY ./shared ./shared
COPY ./image_service ./image_service

WORKDIR /app/image_service

# The proper thing to do is uv sync --lock, with a uv.lock in version control.
# But prof doesn't want us to commit lock files so we can't.
RUN uv sync && uv lock

CMD ["uv", "run", "fastapi", "dev", "src/main.py", "--host", "0.0.0.0","--port", "8000"]
